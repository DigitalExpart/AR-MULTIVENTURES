# ==============================================================================
# AR MULTIVENTURES — MONOREPO ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env for local development with Supabase CLI / Docker.
# NEVER commit real production secrets to version control.

# Data Provider Mode: 'mock' (local development) or 'supabase' (staging/production)
DATA_PROVIDER=mock

# ------------------------------------------------------------------------------
# Supabase Configuration (Local / Hosted)
# ------------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key_here

# ------------------------------------------------------------------------------
# Paystack Payment Gateway Configuration (TEST MODE)
# ------------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signature_secret_here

# ------------------------------------------------------------------------------
# PostgreSQL Direct Database Connection (For Migrations)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
