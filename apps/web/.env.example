# ==============================================================================
# AR MULTIVENTURES — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Data Provider Mode: 'mock' (default offline development) or 'supabase'
VITE_DATA_PROVIDER=mock

# Supabase Project Configuration (Obtain from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# IMPORTANT: Never place SUPABASE_SERVICE_ROLE_KEY in frontend environment files!
