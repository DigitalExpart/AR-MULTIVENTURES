# ==============================================================================
# AR MULTIVENTURES — MOBILE APPLICATION (apps/mobile) ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env for Expo development or EAS build environment variables.

# Data Provider Mode:
# 'mock'     -> Local simulated in-memory store (Displays DEV MOCK DATA banner)
# 'supabase' -> Authoritative backend with JWT Auth, PostgreSQL RLS & RPCs
EXPO_PUBLIC_DATA_PROVIDER=mock

# ------------------------------------------------------------------------------
# Supabase Public Client Configuration
# ------------------------------------------------------------------------------
# Public configuration for mobile client authentication and direct storage uploads.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# ------------------------------------------------------------------------------
# Paystack Public Key (For Mobile Gateway Initialization)
# ------------------------------------------------------------------------------
# Private secret keys must NEVER be bundled in the mobile application.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
